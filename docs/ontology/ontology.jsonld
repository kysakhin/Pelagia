   "dct:source": [
    "TEOS-10 Manual (IOC, SCOR and IAPSO, 2010)"
   ],
   "oceogeo:available": false
  },
  {
   "@id": "oceogeo:doxy",
   "@type": "skos:Concept",
   "skos:inScheme": "oceogeo:scheme",
   "skos:prefLabel": "Dissolved oxygen",
   "skos:altLabel": [
    "oxygen",
    "doxy",
    "O2",
    "oxygenation"
   ],
   "oceogeo:kind": "variable",
   "skos:definition": "Dissolved oxygen concentration; reflects air-sea exchange, photosynthesis, respiration and how long ago water left the surface.",
   "oceogeo:unit": "µmol/kg",
   "oceogeo:argoParameter": "DOXY",
   "skos:exactMatch": {
    "@id": "http://vocab.nerc.ac.uk/standard_name/moles_of_oxygen_per_unit_mass_in_sea_water/"
   },
   "dct:source": [
    "BGC-Argo User's Manual"
   ]
  },
  {
   "@id": "oceogeo:nitrate",
   "@type": "skos:Concept",
   "skos:inScheme": "oceogeo:scheme",
   "skos:prefLabel": "Nitrate",
   "skos:altLabel": [
    "no3",
    "nutrient",
    "nutrients"
   ],
   "oceogeo:kind": "variable",
   "skos:definition": "Nitrate concentration, a major nutrient for phytoplankton growth that also traces remineralisation and water-mass history.",
