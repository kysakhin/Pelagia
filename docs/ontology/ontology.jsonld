   "@id": "oceogeo:south_atlantic",
   "@type": "skos:Concept",
   "skos:inScheme": "oceogeo:scheme",
   "skos:prefLabel": "South Atlantic Ocean",
   "skos:altLabel": [
    "south atlantic",
    "s atlantic",
    "southern atlantic"
   ],
   "oceogeo:kind": "region",
