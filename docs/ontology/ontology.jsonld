   "oceogeo:argoParameter": "NITRATE",
   "skos:exactMatch": {
    "@id": "http://vocab.nerc.ac.uk/standard_name/moles_of_nitrate_per_unit_mass_in_sea_water/"
   },
   "dct:source": [
    "BGC-Argo User's Manual"
   ]
  },
  {
   "@id": "oceogeo:ph",
   "@type": "skos:Concept",
   "skos:inScheme": "oceogeo:scheme",
   "skos:prefLabel": "pH (total scale)",
   "skos:altLabel": [
    "ph",
    "acidity",
    "acidification",
    "ocean acidification",
    "PH_IN_SITU_TOTAL"
   ],
   "oceogeo:kind": "variable",
   "skos:definition": "Seawater acidity, part of the marine carbonate system and the ocean acidification signal.",
