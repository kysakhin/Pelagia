{
 "@context": {
  "skos": "http://www.w3.org/2004/02/skos/core#",
  "dct": "http://purl.org/dc/terms/",
  "oceogeo": "https://oceogeo.app/ontology#"
 },
 "@graph": [
  {
   "@id": "oceogeo:scheme",
   "@type": "skos:ConceptScheme",
   "dct:title": "OceoGeo oceanographic ontology",
   "dct:description": "Concepts used to ground natural-language questions about Argo float data."
  },
  {
   "@id": "oceogeo:collection_variable",
   "@type": "skos:Collection",
   "skos:prefLabel": "Variables",
   "skos:member": [
    "oceogeo:temperature",
    "oceogeo:salinity",
    "oceogeo:pressure",
    "oceogeo:doxy",
    "oceogeo:chla",
    "oceogeo:bbp700",
    "oceogeo:cdom",
    "oceogeo:nitrate",
    "oceogeo:ph",
    "oceogeo:sound_velocity",
    "oceogeo:density"
   ]
  },
  {
   "@id": "oceogeo:collection_coordinate",
   "@type": "skos:Collection",
   "skos:prefLabel": "Coordinates",
   "skos:member": [
    "oceogeo:time",
    "oceogeo:position"
   ]
  },
  {
   "@id": "oceogeo:collection_derived",
   "@type": "skos:Collection",
   "skos:prefLabel": "Derived quantities",
   "skos:member": [
    "oceogeo:mixed_layer_depth",
    "oceogeo:thermocline_depth",
    "oceogeo:isotherm_depth",
    "oceogeo:value_at_depth",
    "oceogeo:surface_value",
    "oceogeo:layer_mean",
    "oceogeo:stratification_index",
    "oceogeo:intermediate_salinity_maximum",
    "oceogeo:intermediate_salinity_minimum",
    "oceogeo:oxygen_minimum",
    "oceogeo:chlorophyll_maximum_depth",
    "oceogeo:depth_anomaly"
   ]
  },
  {
   "@id": "oceogeo:collection_feature",
   "@type": "skos:Collection",
   "skos:prefLabel": "Features",
   "skos:member": [
    "oceogeo:thermocline",
    "oceogeo:mixed_layer",
    "oceogeo:temperature_inversion",
    "oceogeo:oxygen_minimum_zone",
    "oceogeo:deep_chlorophyll_maximum"
   ]
  },
  {
   "@id": "oceogeo:collection_water_mass",
   "@type": "skos:Collection",
   "skos:prefLabel": "Water masses",
   "skos:member": [
    "oceogeo:mediterranean_outflow_water",
    "oceogeo:antarctic_intermediate_water",
    "oceogeo:north_atlantic_central_water",
    "oceogeo:north_atlantic_deep_water",
    "oceogeo:subantarctic_mode_water"
   ]
  },
  {
   "@id": "oceogeo:collection_region",
   "@type": "skos:Collection",
   "skos:prefLabel": "Regions",
   "skos:member": [
    "oceogeo:north_atlantic",
    "oceogeo:south_atlantic",
    "oceogeo:canary_basin",
    "oceogeo:mediterranean_sea",
    "oceogeo:indian_ocean",
    "oceogeo:arabian_sea",
    "oceogeo:north_pacific",
    "oceogeo:south_pacific",
    "oceogeo:southern_ocean",
    "oceogeo:arctic_ocean"
   ]
  },
  {
   "@id": "oceogeo:position",
   "@type": "skos:Concept",
   "skos:inScheme": "oceogeo:scheme",
   "skos:prefLabel": "Position",
   "skos:altLabel": [
    "location",
    "locations",
    "where has",
    "where did",
    "where was",
    "where is the float",
    "latitude",
    "longitude",
    "map",
    "track",
    "trajectory",
    "drift",
    "route",
    "ocean region",
    "which region",
    "what region",
    "which ocean"
   ],
   "oceogeo:kind": "coordinate",
   "skos:definition": "Profile position (one per profile). Use the map chart to show it."
  },
  {
   "@id": "oceogeo:time",
   "@type": "skos:Concept",
   "skos:inScheme": "oceogeo:scheme",
   "skos:prefLabel": "Time",
   "skos:altLabel": [
    "date",
    "when",
    "over time",
    "season",
    "seasonal",
    "month",
    "year",
    "trend",
    "timeline"
   ],
   "oceogeo:kind": "coordinate",
   "skos:definition": "Profile time. Order and plot by observed_at; cycle_number repeats across floats and is not a time axis."
  },
  {
   "@id": "oceogeo:chlorophyll_maximum_depth",
   "@type": "skos:Concept",
   "skos:inScheme": "oceogeo:scheme",
   "skos:prefLabel": "Deep chlorophyll maximum depth",
   "skos:altLabel": [
    "chlorophyll maximum",
    "chlorophyll max",
    "dcm depth",
    "depth of chlorophyll maximum"
   ],
   "oceogeo:kind": "derived",
   "skos:definition": "Depth of the highest chlorophyll-a value in each profile.",
   "oceogeo:method": "Maximum of adjusted-with-fallback CHLA per profile within the top 300 dbar (below that, fluorescence is noise).",
   "oceogeo:unit": "dbar",
   "dct:source": [
    "Cullen (2015) Annu. Rev. Mar. Sci. 7, 207–239"
   ],
   "oceogeo:derivedFrom": [
    {
     "@id": "oceogeo:chla"
    },
    {
     "@id": "oceogeo:pressure"
    }
   ]
  },
  {
   "@id": "oceogeo:depth_anomaly",
   "@type": "skos:Concept",
   "skos:inScheme": "oceogeo:scheme",
   "skos:prefLabel": "Anomaly relative to the project mean",
   "skos:altLabel": [
    "anomaly",
    "anomalies",
    "deviation",
    "compared to average",
    "warmer than usual",
    "colder than usual",
    "unusual"
   ],
   "oceogeo:kind": "derived",
   "skos:definition": "How much each profile differs from the project's mean profile at the same depth.",
   "oceogeo:method": "Bin by 50 dbar; anomaly = profile's bin mean minus the mean over all profiles in that bin. Shown for temperature; swap the variable as needed. This is relative to *this dataset*, not to a climatology.",
   "oceogeo:derivedFrom": [
    {
     "@id": "oceogeo:pressure"
    }
   ]
  },
  {
   "@id": "oceogeo:intermediate_salinity_maximum",
   "@type": "skos:Concept",
   "skos:inScheme": "oceogeo:scheme",
   "skos:prefLabel": "Intermediate salinity maximum",
   "skos:altLabel": [
    "salinity maximum",
    "salinity max",
    "salty layer",
    "saltiest layer",
    "salinity peak"
   ],
   "oceogeo:kind": "derived",
   "skos:definition": "A subsurface local maximum of salinity in the intermediate layer — the classic signature of Mediterranean Outflow Water in the North Atlantic.",
   "oceogeo:method": "Within 600–1600 dbar, levels whose salinity exceeds both neighbours (LAG/LEAD over pressure) are local maxima; the saltiest one per profile is reported. A *local* maximum is used because salinity usually also decreases from a salty surface layer, so the plain maximum below 500 m would just be the top of the window.",
   "oceogeo:unit": "PSU",
   "dct:source": [
    "Talley et al. (2011) Descriptive Physical Oceanography, ch. 9"
   ],
   "oceogeo:derivedFrom": [
    {
     "@id": "oceogeo:salinity"
    },
    {
     "@id": "oceogeo:pressure"
    }
   ]
  },
  {
   "@id": "oceogeo:intermediate_salinity_minimum",
   "@type": "skos:Concept",
   "skos:inScheme": "oceogeo:scheme",
   "skos:prefLabel": "Intermediate salinity minimum",
   "skos:altLabel": [
    "salinity minimum",
    "salinity min",
    "fresh layer",
    "freshest layer"
   ],
   "oceogeo:kind": "derived",
   "skos:definition": "A subsurface local minimum of salinity at intermediate depth — the signature of Antarctic Intermediate Water.",
   "oceogeo:method": "Within 400–1300 dbar, levels whose salinity is below both neighbours; the freshest one per profile is reported.",
   "oceogeo:unit": "PSU",
   "dct:source": [
    "Talley et al. (2011) Descriptive Physical Oceanography, ch. 9, 13"
   ],
   "oceogeo:derivedFrom": [
    {
     "@id": "oceogeo:salinity"
    },
    {
     "@id": "oceogeo:pressure"
    }
   ]
  },
  {
   "@id": "oceogeo:isotherm_depth",
   "@type": "skos:Concept",
   "skos:inScheme": "oceogeo:scheme",
   "skos:prefLabel": "Isotherm depth",
   "skos:altLabel": [
    "isotherm",
    "isotherms"
   ],
   "oceogeo:kind": "derived",
   "skos:definition": "Depth at which water first reaches a given temperature.",
   "oceogeo:method": "Shallowest level (below 5 dbar) whose temperature is at or below the isotherm value, per profile. Change 10 to the requested temperature.",
   "oceogeo:unit": "dbar",
   "dct:source": [
    "Talley et al. (2011) Descriptive Physical Oceanography"
   ],
   "oceogeo:derivedFrom": [
    {
     "@id": "oceogeo:temperature"
    },
    {
     "@id": "oceogeo:pressure"
    }
   ]
  },
  {
   "@id": "oceogeo:layer_mean",
   "@type": "skos:Concept",
   "skos:inScheme": "oceogeo:scheme",
   "skos:prefLabel": "Layer mean",
   "skos:altLabel": [
    "layer average",
    "average between",
    "mean between",
    "upper ocean",
    "upper ocean average",
    "heat content proxy"
   ],
   "oceogeo:kind": "derived",
   "skos:definition": "Mean of a variable over a depth layer, per profile.",
   "oceogeo:method": "Simple mean of all levels inside the layer (levels are not depth-weighted; Argo sampling is denser near the surface).",
   "oceogeo:derivedFrom": [
    {
     "@id": "oceogeo:pressure"
    }
   ]
  },
  {
   "@id": "oceogeo:mixed_layer_depth",
   "@type": "skos:Concept",
   "skos:inScheme": "oceogeo:scheme",
   "skos:prefLabel": "Mixed layer depth",
   "skos:altLabel": [
    "mld",
    "surface mixed layer depth",
    "mixing depth"
   ],
   "oceogeo:kind": "derived",
   "skos:definition": "Depth of the near-surface layer homogenised by wind and convection.",
   "oceogeo:method": "Temperature threshold criterion: the shallowest depth below 10 dbar where temperature is more than 0.2 °C colder than at the ~10 dbar reference. (The density-based 0.03 kg/m³ criterion needs TEOS-10 density, not yet available.)",
   "oceogeo:unit": "dbar",
   "dct:source": [
    "de Boyer Montégut et al. (2004), J. Geophys. Res. 109, C12003"
   ],
   "oceogeo:derivedFrom": [
    {
     "@id": "oceogeo:temperature"
    },
    {
     "@id": "oceogeo:pressure"
    }
   ]
  },
  {
   "@id": "oceogeo:oxygen_minimum",
   "@type": "skos:Concept",
   "skos:inScheme": "oceogeo:scheme",
   "skos:prefLabel": "Oxygen minimum",
   "skos:altLabel": [
    "lowest oxygen",
    "minimum oxygen",
    "oxygen min"
   ],
   "oceogeo:kind": "derived",
   "skos:definition": "Depth and value of the lowest dissolved oxygen in each profile.",
   "oceogeo:method": "Minimum of adjusted-with-fallback DOXY per profile.",
   "oceogeo:unit": "µmol/kg",
   "dct:source": [
    "BGC-Argo User's Manual"
   ],
   "oceogeo:derivedFrom": [
    {
     "@id": "oceogeo:doxy"
    },
    {
     "@id": "oceogeo:pressure"
    }
   ]
  },
  {
   "@id": "oceogeo:stratification_index",
   "@type": "skos:Concept",
   "skos:inScheme": "oceogeo:scheme",
   "skos:prefLabel": "Upper-ocean stratification (temperature proxy)",
   "skos:altLabel": [
    "stratification",
    "stratified",
    "stability",
    "water column stability",
    "vertical structure"
   ],
   "oceogeo:kind": "derived",
   "skos:definition": "How strongly the upper ocean is layered.",
   "oceogeo:method": "Proxy: temperature at ~10 dbar minus temperature at ~200 dbar. Larger means more stratified. A proper buoyancy frequency (N²) needs TEOS-10 density (not yet available).",
   "oceogeo:unit": "°C",
   "dct:source": [
    "Talley et al. (2011) Descriptive Physical Oceanography"
   ],
   "oceogeo:derivedFrom": [
    {
     "@id": "oceogeo:temperature"
    },
    {
     "@id": "oceogeo:pressure"
    }
   ]
  },
  {
   "@id": "oceogeo:surface_value",
   "@type": "skos:Concept",
   "skos:inScheme": "oceogeo:scheme",
   "skos:prefLabel": "Surface value",
   "skos:altLabel": [
    "surface",
    "sea surface",
    "near-surface",
    "at the surface",
    "sst"
   ],
   "oceogeo:kind": "derived",
   "skos:definition": "The shallowest valid measurement of a variable in each profile.",
   "oceogeo:method": "For temperature and salinity use profile_summary.surface_temperature / surface_salinity. For other variables, the shallowest value within the top 10 dbar. Argo floats usually stop sampling a few dbar below the surface, so this is \"near-surface\".",
   "oceogeo:derivedFrom": [
    {
     "@id": "oceogeo:pressure"
    }
   ]
  },
  {
   "@id": "oceogeo:thermocline_depth",
   "@type": "skos:Concept",
   "skos:inScheme": "oceogeo:scheme",
   "skos:prefLabel": "Thermocline depth",
   "skos:altLabel": [
    "temperature gradient",
    "steepest temperature drop"
   ],
   "oceogeo:kind": "derived",
   "skos:definition": "Depth where temperature decreases most rapidly with depth.",
   "oceogeo:method": "Depth of the maximum vertical temperature gradient -dT/dp between consecutive levels, between 10 and 1000 dbar (excludes surface noise).",
   "oceogeo:unit": "dbar",
   "dct:source": [
    "Talley et al. (2011) Descriptive Physical Oceanography, ch. 4"
   ],
   "oceogeo:derivedFrom": [
    {
     "@id": "oceogeo:temperature"
    },
    {
     "@id": "oceogeo:pressure"
    }
   ]
  },
  {
   "@id": "oceogeo:value_at_depth",
   "@type": "skos:Concept",
   "skos:inScheme": "oceogeo:scheme",
   "skos:prefLabel": "Value at a depth",
   "skos:altLabel": [
    "at depth",
    "at a depth",
    "value at depth",
    "at a given depth"
   ],
   "oceogeo:kind": "derived",
   "skos:definition": "A variable's value at (closest to) a requested depth in each profile.",
   "oceogeo:method": "For each profile, the measurement closest to the target pressure within ±50 dbar (DISTINCT ON + ORDER BY distance). Swap temperature for any variable's source expression.",
   "oceogeo:derivedFrom": [
    {
     "@id": "oceogeo:pressure"
    }
   ]
  },
  {
   "@id": "oceogeo:deep_chlorophyll_maximum",
   "@type": "skos:Concept",
   "skos:inScheme": "oceogeo:scheme",
   "skos:prefLabel": "Deep chlorophyll maximum",
   "skos:altLabel": [
    "dcm",
    "subsurface chlorophyll maximum",
    "scm"
   ],
   "oceogeo:kind": "feature",
   "skos:definition": "A subsurface peak in chlorophyll, typical of stratified, nutrient-poor waters where phytoplankton grow near the nutricline.",
   "dct:source": [
    "Cullen (2015) Annu. Rev. Mar. Sci. 7, 207–239"
   ],
   "oceogeo:featureOf": [
    {
     "@id": "oceogeo:chla"
    }
   ],
   "oceogeo:measuredBy": [
    {
     "@id": "oceogeo:chlorophyll_maximum_depth"
    }
   ]
  },
  {
   "@id": "oceogeo:mixed_layer",
   "@type": "skos:Concept",
   "skos:inScheme": "oceogeo:scheme",
   "skos:prefLabel": "Mixed layer",
   "skos:altLabel": [],
   "oceogeo:kind": "feature",
   "skos:definition": "The well-mixed surface layer of nearly uniform temperature and salinity.",
   "oceogeo:featureOf": [
    {
     "@id": "oceogeo:temperature"
    }
   ],
   "oceogeo:measuredBy": [
    {
     "@id": "oceogeo:mixed_layer_depth"
    }
   ]
  },
  {
   "@id": "oceogeo:oxygen_minimum_zone",
   "@type": "skos:Concept",
   "skos:inScheme": "oceogeo:scheme",
   "skos:prefLabel": "Oxygen minimum zone",
   "skos:altLabel": [
    "omz",
    "hypoxic",
    "hypoxia",
    "suboxic",
    "low oxygen",
    "dead zone"
   ],
   "oceogeo:kind": "feature",
   "skos:definition": "A subsurface layer of strongly depleted oxygen, typically 200–1000 m in the eastern tropical Pacific, Arabian Sea and Bay of Bengal.",
   "oceogeo:method": "Thresholds vary by community: hypoxic < 60 µmol/kg, suboxic < 20 µmol/kg. Report which threshold is used.",
   "dct:source": [
    "Paulmier & Ruiz-Pino (2009) Prog. Oceanogr. 80, 113–128"
   ],
   "oceogeo:featureOf": [
    {
     "@id": "oceogeo:doxy"
    }
   ],
   "oceogeo:measuredBy": [
    {
     "@id": "oceogeo:oxygen_minimum"
    }
   ]
  },
  {
   "@id": "oceogeo:temperature_inversion",
   "@type": "skos:Concept",
   "skos:inScheme": "oceogeo:scheme",
   "skos:prefLabel": "Temperature inversion",
   "skos:altLabel": [
    "inversion",
    "inversions",
    "warmer below",
    "warming with depth"
   ],
   "oceogeo:kind": "feature",
   "skos:definition": "Temperature increasing with depth over some interval. Stable only when the deeper water is saltier; common below the mixed layer near fronts, sea ice and where warm salty water intrudes beneath fresher water.",
   "oceogeo:method": "Between consecutive levels below 20 dbar, temperature increases by more than 0.1 °C with depth (small steps are sensor noise).",
   "dct:source": [
    "Talley et al. (2011) Descriptive Physical Oceanography"
   ],
   "oceogeo:featureOf": [
    {
     "@id": "oceogeo:temperature"
    },
    {
     "@id": "oceogeo:salinity"
    }
   ]
  },
  {
   "@id": "oceogeo:thermocline",
   "@type": "skos:Concept",
   "skos:inScheme": "oceogeo:scheme",
   "skos:prefLabel": "Thermocline",
   "skos:altLabel": [],
   "oceogeo:kind": "feature",
   "skos:definition": "The layer where temperature drops rapidly with depth, separating warm surface water from cold deep water.",
   "oceogeo:featureOf": [
    {
     "@id": "oceogeo:temperature"
    }
   ],
   "oceogeo:measuredBy": [
    {
     "@id": "oceogeo:thermocline_depth"
    }
   ]
  },
  {
   "@id": "oceogeo:arabian_sea",
   "@type": "skos:Concept",
   "skos:inScheme": "oceogeo:scheme",
   "skos:prefLabel": "Arabian Sea",
   "skos:altLabel": [],
   "oceogeo:kind": "region",
   "oceogeo:latRange": [
    0,
    25
   ],
   "oceogeo:lonRanges": [
    [
     50,
     78
    ]
   ],
   "skos:broader": [
    {
     "@id": "oceogeo:indian_ocean"
    }
   ]
  },
  {
   "@id": "oceogeo:arctic_ocean",
   "@type": "skos:Concept",
   "skos:inScheme": "oceogeo:scheme",
   "skos:prefLabel": "Arctic Ocean",
   "skos:altLabel": [
    "arctic",
    "polar north",
    "high arctic"
   ],
   "oceogeo:kind": "region",
   "oceogeo:latRange": [
    66.5,
    90
   ],
   "oceogeo:lonRanges": [
    [
     -180,
     180
    ]
   ]
  },
  {
   "@id": "oceogeo:canary_basin",
   "@type": "skos:Concept",
   "skos:inScheme": "oceogeo:scheme",
   "skos:prefLabel": "Canary Basin",
   "skos:altLabel": [
    "canary",
    "canaries",
    "canary current",
    "off west africa",
    "northwest africa"
   ],
   "oceogeo:kind": "region",
   "oceogeo:latRange": [
    20,
    36
   ],
   "oceogeo:lonRanges": [
    [
     -30,
     -10
    ]
   ],
   "skos:broader": [
    {
     "@id": "oceogeo:north_atlantic"
    }
   ]
  },
  {
   "@id": "oceogeo:indian_ocean",
   "@type": "skos:Concept",
   "skos:inScheme": "oceogeo:scheme",
   "skos:prefLabel": "Indian Ocean",
   "skos:altLabel": [],
