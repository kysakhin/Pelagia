   ]
  },
  {
   "@id": "oceogeo:pressure",
   "@type": "skos:Concept",
   "skos:inScheme": "oceogeo:scheme",
   "skos:prefLabel": "Pressure (depth)",
   "skos:altLabel": [
    "pressure",
    "depth",
    "dbar",
    "deep",
    "deeper",
    "metres",
    "meters",
    "PRES"
   ],
   "oceogeo:kind": "variable",
   "skos:definition": "Sea water pressure; 1 dbar is approximately 1 m of depth, so pressure is used as the depth coordinate. depth_level is an array index, not a depth.",
   "oceogeo:unit": "dbar",
   "oceogeo:argoParameter": "PRES",
   "skos:exactMatch": {
    "@id": "http://vocab.nerc.ac.uk/standard_name/sea_water_pressure/"
   },
   "dct:source": [
    "Argo Quality Control Manual"
   ]
  },
  {
   "@id": "oceogeo:salinity",
   "@type": "skos:Concept",
   "skos:inScheme": "oceogeo:scheme",
   "skos:prefLabel": "Salinity",
   "skos:altLabel": [
    "salt",
    "saltiness",
    "psal",
    "PSU",
    "practical salinity"
   ],
   "oceogeo:kind": "variable",
   "skos:definition": "Practical salinity (dissolved salt content). Set at the surface by evaporation minus precipitation, and at depth by water-mass mixing.",
   "oceogeo:unit": "PSU",
   "oceogeo:argoParameter": "PSAL",
   "skos:exactMatch": {
    "@id": "http://vocab.nerc.ac.uk/standard_name/sea_water_practical_salinity/"
   },
   "dct:source": [
    "TEOS-10 Manual (IOC, SCOR and IAPSO, 2010)"
   ]
  },
  {
   "@id": "oceogeo:sound_velocity",
   "@type": "skos:Concept",
   "skos:inScheme": "oceogeo:scheme",
   "skos:prefLabel": "Sound speed",
   "skos:altLabel": [
    "sound velocity",
    "speed of sound",
    "sofar",
    "SOFAR channel",
    "acoustic"
   ],
   "oceogeo:kind": "variable",
   "skos:definition": "Speed of sound in seawater, a function of temperature, salinity and pressure; typically 1450–1550 m/s. Its minimum near ~1000 m forms the SOFAR channel, a waveguide for long-range sound.",
   "oceogeo:unit": "m/s",
   "dct:source": [
    "Chen & Millero (1977) J. Acoust. Soc. Am. 62, 1129",
    "TEOS-10 Manual"
   ],
   "oceogeo:available": false
  },
  {
   "@id": "oceogeo:temperature",
   "@type": "skos:Concept",
   "skos:inScheme": "oceogeo:scheme",
   "skos:prefLabel": "Temperature",
   "skos:altLabel": [
    "temp",
    "sea temperature",
    "water temperature",
    "thermal"
   ],
   "oceogeo:kind": "variable",
   "skos:definition": "In-situ sea water temperature. With salinity it sets seawater density and therefore stratification.",
   "oceogeo:unit": "°C",
   "oceogeo:argoParameter": "TEMP",
   "skos:exactMatch": {
    "@id": "http://vocab.nerc.ac.uk/standard_name/sea_water_temperature/"
   },
   "dct:source": [
    "Argo User's Manual",
    "Talley et al. (2011) Descriptive Physical Oceanography"
   ]
  },
  {
   "@id": "oceogeo:antarctic_intermediate_water",
   "@type": "skos:Concept",
   "skos:inScheme": "oceogeo:scheme",
   "skos:prefLabel": "Antarctic Intermediate Water (AAIW)",
   "skos:altLabel": [
    "antarctic intermediate water",
    "aaiw",
    "intermediate water"
   ],
   "oceogeo:kind": "water_mass",
   "skos:definition": "Cool, fresh intermediate water formed near the Subantarctic Front; a local salinity minimum at ~700–1000 dbar. Fresh (34.2–34.5) in the southern oceans; diluted (~35.0–35.2) where it reaches the subtropical North Atlantic.",
   "dct:source": [
    "Emery & Meincke (1986)",
    "Talley et al. (2011) ch. 13"
   ],
   "oceogeo:depthRangeDbar": [
    500,
    1300
   ],
   "oceogeo:foundIn": [
    {
     "@id": "oceogeo:southern_ocean"
    },
    {
     "@id": "oceogeo:south_atlantic"
    },
    {
     "@id": "oceogeo:indian_ocean"
    },
    {
     "@id": "oceogeo:south_pacific"
    },
    {
     "@id": "oceogeo:north_atlantic"
    }
   ],
   "oceogeo:identifiedBy": [
    {
     "@id": "oceogeo:intermediate_salinity_minimum"
    }
   ]
  },
  {
   "@id": "oceogeo:mediterranean_outflow_water",
   "@type": "skos:Concept",
   "skos:inScheme": "oceogeo:scheme",
   "skos:prefLabel": "Mediterranean Outflow Water (MOW)",
   "skos:altLabel": [
    "mediterranean outflow water",
    "mediterranean water",
    "mow",
    "meddy",
    "meddies",
    "mediterranean outflow"
   ],
   "oceogeo:kind": "water_mass",
   "skos:definition": "Warm, salty intermediate water from the Strait of Gibraltar spreading into the eastern North Atlantic at ~1000 m. Shows as a local salinity maximum near 1000–1300 dbar: strong (> 36 PSU) near the Gulf of Cadiz, diluted to ~35.2–35.5 PSU in the Canary Basin and further away.",
   "dct:source": [
    "Emery & Meincke (1986)",
    "Talley et al. (2011) ch. 9"
   ],
   "oceogeo:depthRangeDbar": [
    600,
    1600
   ],
   "oceogeo:foundIn": [
    {
     "@id": "oceogeo:north_atlantic"
    }
   ],
   "oceogeo:identifiedBy": [
    {
     "@id": "oceogeo:intermediate_salinity_maximum"
    }
   ]
  },
  {
   "@id": "oceogeo:north_atlantic_central_water",
   "@type": "skos:Concept",
   "skos:inScheme": "oceogeo:scheme",
   "skos:prefLabel": "North Atlantic Central Water (NACW)",
   "skos:altLabel": [
    "north atlantic central water",
    "central water",
    "nacw",
    "enacw",
    "thermocline water"
   ],
   "oceogeo:kind": "water_mass",
   "skos:definition": "The thermocline water of the subtropical North Atlantic: an almost linear temperature–salinity relation between ~8 °C/35.0 and ~19 °C/36.7 in the upper few hundred metres.",
   "dct:source": [
    "Emery & Meincke (1986)",
    "Talley et al. (2011) ch. 9"
   ],
   "oceogeo:depthRangeDbar": [
    100,
    700
   ],
   "oceogeo:foundIn": [
    {
     "@id": "oceogeo:north_atlantic"
    }
   ]
  },
  {
   "@id": "oceogeo:north_atlantic_deep_water",
   "@type": "skos:Concept",
   "skos:inScheme": "oceogeo:scheme",
   "skos:prefLabel": "North Atlantic Deep Water (NADW)",
   "skos:altLabel": [
    "north atlantic deep water",
    "nadw",
    "deep water"
   ],
   "oceogeo:kind": "water_mass",
   "skos:definition": "Cold, relatively salty deep water formed in the Nordic and Labrador Seas. Core Argo floats (2000 dbar) only sample its upper part.",
   "dct:source": [
    "Emery & Meincke (1986)",
    "Talley et al. (2011) ch. 9"
   ],
   "oceogeo:depthRangeDbar": [
    1500,
    4000
   ],
   "oceogeo:foundIn": [
    {
     "@id": "oceogeo:north_atlantic"
    },
    {
     "@id": "oceogeo:south_atlantic"
    }
   ]
  },
  {
   "@id": "oceogeo:subantarctic_mode_water",
   "@type": "skos:Concept",
   "skos:inScheme": "oceogeo:scheme",
   "skos:prefLabel": "Subantarctic Mode Water (SAMW)",
   "skos:altLabel": [
    "subantarctic mode water",
    "samw",
    "mode water"
   ],
   "oceogeo:kind": "water_mass",
   "skos:definition": "A thick, weakly stratified layer formed by deep winter mixing just north of the Subantarctic Front; shows as a thermostad (small vertical temperature gradient) in the upper ~600 m.",
   "dct:source": [
    "Talley et al. (2011) ch. 13"
   ],
   "oceogeo:depthRangeDbar": [
    200,
    700
   ],
   "oceogeo:foundIn": [
    {
     "@id": "oceogeo:southern_ocean"
    },
    {
     "@id": "oceogeo:indian_ocean"
    },
    {
     "@id": "oceogeo:south_pacific"
    },
    {
     "@id": "oceogeo:south_atlantic"
    }
   ]
  }
 ]
